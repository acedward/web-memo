* text=auto eol=lf

# The vendored WASM bundle is a build artifact. Treat the binary as binary and
# keep the generated JS/TS glue byte-exact so its SHA-256 in
# vendor/pkg/SHA256SUMS stays verifiable on every platform.
vendor/pkg/**            -text
vendor/pkg/*.wasm        binary

# The frozen reference artifacts are binary and their SHA-256s are published in
# fixtures/SHA256SUMS. Nothing may normalise a byte of them on any platform.
fixtures/*.bin           binary
